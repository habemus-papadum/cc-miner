{
  "name": "pdum-cc-miner",
  "version": "0.12.0",
  "description": "Understand your own Claude Code usage, and whether it was time well spent.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nehal Patel <nehal.alum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/cc-miner.git",
    "directory": "pdum-cc-miner"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build",
    "claude": "aiui claude",
    "dev": "vite",
    "dev:electron": "node electron/dev.mjs",
    "icon": "node electron/make-icon.mjs",
    "normalize": "pnpm -C ../cc-assay normalize -- --out ../pdum-cc-miner/src/data",
    "open": "aiui open",
    "pack:dir": "node electron/pack.mjs dir",
    "pack:linux": "node electron/pack.mjs linux",
    "pack:mac": "node electron/pack.mjs mac",
    "preview": "vite preview",
    "serve": "node server/duckdb-host.mjs",
    "serve:s3": "node server/duckdb-host.mjs --s3-prefix",
    "smoke": "node electron/smoke.mjs",
    "start:electron": "electron electron/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev61.0",
    "@duckdb/node-api": "1.5.5-r.2",
    "@habemus-papadum/aiui-source-processor": "^0.12.0",
    "@habemus-papadum/aiui-viz": "^0.12.0",
    "@habemus-papadum/cc-assay": "workspace:^",
    "@observablehq/plot": "^0.6.17",
    "@solidjs/web": "2.0.0-beta.15",
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "@uwdata/vgplot": "0.28.1",
    "electron-updater": "^6.8.9",
    "solid-js": "2.0.0-beta.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@habemus-papadum/aiui": "^0.12.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^6.4.1",
    "vite-plugin-solid": "3.0.0-next.5",
    "vitest": "^3.2.0"
  }
}
